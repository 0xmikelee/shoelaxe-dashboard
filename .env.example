# ─── Database ────────────────────────────────────────────────────────────────
# Supavisor SESSION-mode pooler (port 5432 on the *pooler* host). Copy it from
# Supabase → Project Settings → Database → Connection string → Session pooler.
#
# NEVER use db.<ref>.supabase.co here: that hostname resolves to IPv6 only, and
# DigitalOcean App Platform cannot connect to IPv6 hosts. The app will fail to
# start with ECONNREFUSED and the cause is not obvious from the error.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<n>-ap-southeast-1.pooler.supabase.com:5432/postgres

# Direct connection, used only by `supabase db push` and `supabase gen types`.
DIRECT_DATABASE_URL=

PG_POOL_MAX=5
# false only when running through a transaction-mode pooler; session mode supports prepares.
PG_PREPARE=true

# ─── Supabase (auth + Storage only; never data access) ───────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Machine auth for the Apps Script ────────────────────────────────────────
# Also set as a Script Property named INGEST_SECRET in the Apps Script project.
INGEST_SECRET=

# ─── KicksDB (GOAT catalog during ingest) ────────────────────────────────────
# Bearer token from https://kicks.dev. When unset, ingest still prices; product
# name/brand/model/description/colorway/season/release date/images are skipped.
KICKSDB_API_KEY=

# ─── Runtime role ────────────────────────────────────────────────────────────
# web = the Next.js service; worker = the background job runner (`pnpm worker`).
APP_ROLE=web

# ─── Publishing ──────────────────────────────────────────────────────────────
# none = build and queue everything, call nothing. Explicit on purpose: a missing
# credential must never degrade silently into "everything skipped, dashboard green".
PUBLISH_TARGET=none
# Required when PUBLISH_TARGET=shopify, and by `pnpm shopify:probe` / `pnpm shopify:ping`.
# Leave PUBLISH_TARGET=none for `pnpm dev` / MSW; the probe scripts read these independently.
#
# There is no static Admin token any more. The app's client credentials are exchanged for a
# 24-hour access token at runtime (client credentials grant), so the two values below are the
# credential. Both come from the Dev Dashboard app → API key and secret key. The grant only
# works while the app and the store sit in the same Shopify organization.
#
# App scopes, approved on the store by releasing an app version (Admin GraphQL 2026-07):
#   read_products, write_products, read_inventory, write_inventory,
#   read_locations, read_markets_home
#
# SHOPIFY_LOCATION_ID is the Admin GID (gid://shopify/Location/…). `pnpm shopify:probe`
# writes it into .env.local when the store has exactly one active location.
SHOPIFY_STORE_DOMAIN=shoelaxe-test.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_LOCATION_ID=
