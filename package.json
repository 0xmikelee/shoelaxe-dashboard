{
  "name": "shoelaxe-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "coverage": "vitest run --project unit --coverage",
    "db:reset": "supabase db reset --workdir ../Shoelaxe",
    "db:types": "supabase gen types typescript --local --workdir ../Shoelaxe > lib/db/types.generated.ts",
    "docs:openapi": "tsx scripts/build-openapi.ts",
    "cost": "tsx scripts/token-report.ts",
    "shopify:probe": "tsx scripts/shopify-probe.ts",
    "shopify:ping": "tsx scripts/shopify-ping.ts",
    "worker": "tsx worker/index.ts",
    "test:components": "vitest run --project components",
    "test:all": "vitest run --project unit --project components",
    "api:types": "openapi-typescript ./docs/openapi.json -o ./lib/api/schema.d.ts",
    "contract": "pnpm docs:openapi && pnpm api:types"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "5.102.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "openapi-fetch": "0.17.0",
    "postgres": "^3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "server-only": "^0.0.1",
    "shadcn": "4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "5.102.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
